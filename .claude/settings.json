{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet publish *)",
      "Bash(pwsh -File tools/pre-pr.ps1 *)",
      "PowerShell(pwsh -File tools/pre-pr.ps1 *)",
      "PowerShell(./tools/pre-pr.ps1 *)",
      "Bash(python3 tools/docs/check.py *)",
      "Bash(python3 verify.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git range-diff *)",
      "Bash(git worktree list *)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh api -X GET *)",
      "Bash(gh api -X PATCH repos/*/issues/comments/*)"
    ],
    "deny": [
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *-uf*)",
      "Bash(git push *-fu*)",
      "Bash(git push *+*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/docs/check.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
