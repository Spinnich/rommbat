<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RomMBat.Tests</RootNamespace>
    <AssemblyName>RomMBat.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 runs tests from an executable, not a library. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RomMBat.Core\RomMBat.Core.csproj" />
    <ProjectReference Include="..\..\src\RomM.Client\RomM.Client.csproj" />
  </ItemGroup>

  <!--
    Fixtures are byte-exact captures from a real RetroBat install. Copied rather than
    embedded so a failing test can be diffed against the file on disk.
  -->
  <ItemGroup>
    <!-- Update, not Include: the SDK's default None glob already covers these. -->
    <None Update="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Linked rather than copied, so the mapping regression runs against the same bytes the
    reference data and the generator do. Duplicating them into fixtures/ would let the copy
    drift from the file the numbers were derived from, which is the one thing that must not
    happen here.

    Every path here must be a tracked file. probe-output/ is gitignored scratch, so linking
    from it builds on the machine that produced it and nowhere else; the live es_systems
    capture is checked in under fixtures/ instead.
  -->
  <ItemGroup>
    <None Include="..\..\reference\es_systems.cfg" Link="fixtures\es_systems.template.cfg"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\reference\systems_names.lst" Link="fixtures\systems_names.lst"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\retrobat\platforms.json" Link="fixtures\platforms.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\retrobat\bios.json" Link="fixtures\bios.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\reference\batocera-systems.json" Link="fixtures\batocera-systems.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\reference\es_savestates.cfg" Link="fixtures\es_savestates.template.cfg"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      Globbed, because the pin's filename carries the version it came from and moving the pin
      renames it. The fixed Link means two pins present at once collide at build time, which is
      the right failure: there is exactly one pinned schema.
    -->
    <None Include="..\..\src\RomM.Client\openapi\romm-*.json" Link="fixtures\romm-pinned-openapi.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
