<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RomMBat.Tests</RootNamespace>
    <AssemblyName>RomMBat.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RomMBat.Core\RomMBat.Core.csproj" />
    <ProjectReference Include="..\..\src\RomM.Client\RomM.Client.csproj" />
  </ItemGroup>

  <!--
    Fixtures are byte-exact captures from a real RetroBat install. Copied rather than
    embedded so a failing test can be diffed against the file on disk.
  -->
  <ItemGroup>
    <!-- Update, not Include: the SDK's default None glob already covers these. -->
    <None Update="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Linked rather than copied, so the mapping regression runs against the same bytes the
    reference data and the generator do. Duplicating them into fixtures/ would let the copy
    drift from the file the numbers were derived from, which is the one thing that must not
    happen here.
  -->
  <ItemGroup>
    <None Include="..\..\reference\es_systems.cfg" Link="fixtures\es_systems.template.cfg"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\reference\systems_names.lst" Link="fixtures\systems_names.lst"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\probe-output\es_systems.json" Link="fixtures\es_systems.live.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\retrobat\platforms.json" Link="fixtures\platforms.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
