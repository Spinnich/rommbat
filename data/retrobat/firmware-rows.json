  "directories": {
    "libretro": {
      "path": "bios",
      "evidence": "RB-317: RetroArch's system directory is bios\\, where libretro/mesen-s found dsp1b.rom"
    },
    "bizhawk": {
      "path": "bios",
      "by_hash": true,
      "evidence": "RB-317 and RB-322: BizHawk found dsp1b.rom, and the Master System BIOS under RetroBat's name, in bios\\, so it matches a file by its hash and not its name"
    },
    "mesen": {
      "path": "emulators/mesen",
      "evidence": "RB-317: Mesen reads firmware only from emulators\\mesen\\Firmware\\, where RetroBat puts nothing; retrobios's profile paths start at Firmware/"
    }
  },
