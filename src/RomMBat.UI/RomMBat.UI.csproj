<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RomMBat.UI</RootNamespace>
    <!-- The es_menu entry launches this name. -->
    <AssemblyName>RomMBat</AssemblyName>
    <Description>
      Full-screen gamepad-navigable front end, launched from EmulationStation.
    </Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The framework is Avalonia, settled in M7 stage 7a on size: WPF cannot be trimmed and
    needs the Windows Desktop runtime inside a self-contained publish. The package arrives
    with the app in stage 7b, so nothing is referenced yet and OutputType stays Exe rather
    than WinExe until it is. Presentation owns no logic: set resolution, mapping, conflict
    handling and the outbox all live in RomMBat.Core.
  -->

  <ItemGroup>
    <ProjectReference Include="..\RomMBat.Core\RomMBat.Core.csproj" />
  </ItemGroup>

</Project>
