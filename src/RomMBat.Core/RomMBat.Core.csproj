<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RomMBat.Core</RootNamespace>
    <AssemblyName>RomMBat.Core</AssemblyName>
    <Description>
      Local state and everything that knows RetroBat's disk layout: the SQLite store,
      the outbox, root discovery, config readers and writers, mapping and sync.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomM.Client\RomM.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <!--
    Migrations are embedded rather than copied, so a single-file publish carries them and
    nothing has to resolve a path to find the schema. They are ordered by resource name, so
    the NNN- prefix is load-bearing.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Store\Migrations\*.sql" />
  </ItemGroup>

  <!--
    data/retrobat/*.json are shipped tables read at runtime. Embedded for the same reason
    the migrations are: a single-file publish carries them and nothing has to resolve a
    path to find them. The link name is what the resource name is built from, so moving
    one breaks the lookup in the class that reads it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\retrobat\platforms.json" Link="data\retrobat\platforms.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RomMBat.Tests" />
  </ItemGroup>

</Project>
