<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RomMBat.Hook</RootNamespace>
    <!--
      EmulationStation runs every file in an event folder and passes the game's arguments
      positionally, so the hook is invoked by its path with no subcommand. The event it is
      serving comes from the name of the folder it was installed into.
    -->
    <AssemblyName>rommbat-hook</AssemblyName>
    <Description>
      The EmulationStation event hook. Writes one spool file and exits. It opens no socket,
      touches no database and takes no lock, because it runs inside the game-launch path.
    </Description>

    <!--
      Deliberately references nothing, not even RomMBat.Core. Four copies of this file are
      installed, one per event folder, so every megabyte is paid four times on a portable
      drive. Measured: 12.8 MB like this, 15.1 MB the moment Microsoft.Data.Sqlite is
      referenced, and 75.9 MB if the agent itself were installed as the hook.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Required because the app is trimmed. Trimming rewrites the framework assemblies and
      discards the precompiled native code they ship with, so a trimmed app with no R2R of
      its own JITs everything from IL on every start. Measured on a USB stick, one hook
      invocation: 111 ms trimmed without this, 49 ms with it, and 74 ms untrimmed. The 62 ms
      is JIT and not disk, which is why it shows up on the spool write too: the same
      File.Move costs 51.5 ms in the trimmed build and 7.0 ms here.

      It costs 1.8 MB per copy, 7.2 MB across the four installs, against 1.7 MB saved by
      EnableCompressionInSingleFile, which is kept because it is nearly free at 4 ms.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Linked source rather than a project reference, because a reference to RomMBat.Core would
    bring the store and the API client with it. The spool format's canonical home is Core,
    which is the end that has to keep reading files an older hook wrote; this project compiles
    the same two files so the writer and the reader cannot drift.
  -->
  <ItemGroup>
    <Compile Include="..\RomMBat.Core\Paths\RootMarkers.cs" Link="Shared\RootMarkers.cs" />
    <Compile Include="..\RomMBat.Core\Sync\SpoolRecord.cs" Link="Shared\SpoolRecord.cs" />
    <Compile Include="..\RomMBat.Core\Sync\Spool.cs" Link="Shared\Spool.cs" />
  </ItemGroup>

</Project>
