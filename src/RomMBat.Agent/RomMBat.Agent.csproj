<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RomMBat.Agent</RootNamespace>
    <!-- The ES hook .bat files invoke this name; changing it breaks installed hooks. -->
    <AssemblyName>rommbat-agent</AssemblyName>
    <Description>
      Short-lived console agent. Subcommands: pair, sync, game-start, game-end, flush,
      status. The game-* subcommands are journal-only and never open a socket.
    </Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomMBat.Core\RomMBat.Core.csproj" />
  </ItemGroup>

  <!--
    The command classes are internal, because nothing outside this exe dispatches them. The
    gates inside them are where a milestone's planner, sync, store and exit code meet, which
    is the layer a defect survives a green suite in, so the test project sees them.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="RomMBat.Agent.Tests" />
  </ItemGroup>

</Project>
