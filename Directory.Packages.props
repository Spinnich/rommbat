<Project>

  <!--
    Central package management. Versions live here; projects carry a bare
    <PackageReference Include="..." /> with no Version attribute.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Microsoft.Data.Sqlite, not EF Core: the schema is hand-written SQL applied by an
    ordered migration list, and nothing here needs a change tracker. The package bundles
    the e_sqlite3 native library, which single-file publish carries.
  -->
  <ItemGroup Label="Local store">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!--
    QRCoder is MIT, and the generator this uses is pure managed, so it survives
    self-contained single-file publish. The package also references System.Drawing.Common,
    which only its image renderers need. Nothing here calls those, so that assembly rides
    along unused.
  -->
  <ItemGroup Label="Pairing">
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!--
    Avalonia, settled in M7 stage 7a and arriving with the UI in 7b. Win32 and Skia are
    referenced by name rather than through Avalonia.Desktop: RomMBat ships win-x64 only, and
    Avalonia.Desktop pulls Tmds.DBus.Protocol in for the X11 backend, which raises NU1903 for
    a known high-severity advisory and so fails the -warnaserror build for a backend nothing
    here can use.

    Avalonia.HarfBuzz is what registers the text shaper. Avalonia 12 split shaping out of
    Avalonia.Skia, so without it UseSkia alone builds clean and throws at the first frame.

    NSwag is a local dotnet tool (.config/dotnet-tools.json), not a package reference:
    generated output is committed, so nothing generates at build time.
  -->
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Win32" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.2" />
  </ItemGroup>

  <!--
    xunit is on the v3 line; the v2 packages are flagged Legacy. v3 skips at runtime on
    its own (Assert.Skip and friends), which is what retired Xunit.SkippableFact: that
    package pins the suite to v2 by depending on xunit.extensibility.execution, and is
    MS-PL, which the FSF reads as GPL-incompatible.

    v3 test projects are executables rather than libraries, so the test csproj sets
    OutputType. v3 carries its own Microsoft.Testing.Platform runner, which is what the
    .NET 10 SDK wants: it dropped support for driving that platform through VSTest, so
    Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are gone rather than upgraded.
    dotnet.config at the root opts `dotnet test` into the same platform.
  -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
