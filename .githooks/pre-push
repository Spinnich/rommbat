#!/usr/bin/env bash
# Refuse direct pushes to main.
#
# This duplicates a server-side ruleset rather than standing in for one: GitHub enforces both
# the pull request and the required checks. The hook is kept because it answers in under a
# second with the next command, where pushing anyway costs an upload and returns GH013.
#
# No bypass, because the server refuses regardless and a local hatch could only delay the
# rejection. It also does not name the required checks: the list it used to carry drifted out
# of step with the ruleset, and nothing caught it.

set -uo pipefail

protected='refs/heads/main'

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	[ "$remote_ref" = "$protected" ] || continue

	cat >&2 <<'MSG'

pre-push: refusing to push directly to main.

  main takes pull requests only, enforced by a GitHub ruleset. Branch and open one:

      git switch -c my-change
      git push -u origin my-change
      gh pr create --fill

  The required checks have to go green before it can merge.

MSG
	exit 1
done

exit 0
