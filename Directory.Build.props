<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!--
    win-x64 is the only shipping target, but the RID and self-contained flag are
    passed at publish time rather than pinned here, so plain `dotnet build` and
    `dotnet test` stay RID-agnostic. See the publish commands in DEVELOPER_SETUP.md.
  -->

  <PropertyGroup>
    <Product>RomMBat</Product>
    <Company>RomMBat contributors</Company>
    <Copyright>Copyright (C) RomMBat contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/rommapp/rommbat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Pre-release. M8 wires this to the release tag. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Deterministic output, so rebuilding a commit produces the same bytes and a
      published artefact can be checked against its tag.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
